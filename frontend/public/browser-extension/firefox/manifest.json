{
  "manifest_version": 2,
  "name": "PaperRoseAI Page Reader",
  "version": "1.0.0",
  "description": "Copy the visible text of a page into PaperRoseAI for a user-reviewed analysis.",
  "permissions": ["activeTab", "clipboardWrite"],
  "browser_action": {
    "default_title": "Review this page with PaperRoseAI",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "paperrose-page-reader@paperbagexpress.com",
      "strict_min_version": "109.0"
    }
  }
}
