# Copy to .env and fill in — but you don't have to:
# the recommended way to add AI keys is the ⚙️ settings modal in the app,
# which verifies them live and stores them in backend/keys.json.

# --- Local-only AI keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Public deployment configuration ---
# Leave unset/0 for local development. Set to 1 for public hosted deployments.
PAPERROSE_PUBLIC_MODE=0
PAPERROSE_ALLOWED_ORIGINS=https://your-paperrose-domain.vercel.app

# Cloudflare Turnstile: configure these to require a human check before each public scan.
# Public scans fail closed unless all three settings below are configured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=your-paperrose-domain.vercel.app

# Optional Workers AI for URL scans only. Users must opt in on each scan.
# Free quota is shared at account level and content isn't used to train models;
# still avoid sending personal or sensitive text to any hosted AI service.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_TIER_CONSENT=0

# --- Optional: point at a gateway or a local OpenAI-compatible server ---
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Optional: where keys saved from the local UI are stored ---
# PAPERROSE_KEYS_PATH=backend/keys.json

# --- Optional: skip the startup key check ---
# PAPERROSE_SKIP_KEY_CHECK=1
